# Copy to .env.local
# Base URL the browser uses for API calls. Keep it relative (/api/v1): the web
# server forwards it to the API (see next.config.ts), which works from this
# machine and from other devices on the same Wi-Fi.
NEXT_PUBLIC_API_URL=/api/v1

# Where the web server forwards /api/v1 to (server-side). Default below.
# API_PROXY_TARGET=http://localhost:4000
