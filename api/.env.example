# Copy this file to .env and fill in real values. Never commit .env.

# Port and interface the API listens on. 0.0.0.0 = reachable from other
# devices on the same Wi-Fi (local testing); 127.0.0.1 = this machine only.
PORT=4000
HOST=0.0.0.0

# PostgreSQL connection string (local Homebrew Postgres usually needs no password)
DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/precon_erp"

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a login token stays valid (e.g. 15m, 8h, 1d)
JWT_EXPIRES_IN=8h

# Comma-separated list of web origins allowed to call the API directly.
# The web app normally goes through its own /api/v1 proxy (same origin, no
# CORS needed); list LAN origins here only if a browser calls the API directly,
# e.g. http://192.168.31.50:3000
CORS_ORIGINS=http://localhost:3000

# Password given to every seeded demo user (local/demo use only)
SEED_USER_PASSWORD=change-me-demo-password

# Optional business settings
# Time zone used for "today" (overdue checks, dates): default Asia/Kolkata
# BUSINESS_TIMEZONE=Asia/Kolkata
# Weekly off day(s) for leave/LOP, as JS weekday numbers (0=Sunday … 6=Saturday): default 0
# WEEKLY_OFF_DAYS=0

# --- Public create-lead API ---
# Requests per minute allowed per API key (and per IP for the Meta webhook x10).
# PUBLIC_API_RATE_LIMIT=60

# --- Meta (Facebook) Lead Ads webhook (see README "Meta lead ads webhook") ---
# Leave empty until the Meta app is set up; the webhook then answers 503 "not configured".
# Any random string you choose; enter the same value in the Meta app's Webhooks settings.
META_VERIFY_TOKEN=
# Meta app -> App settings -> Basic -> App secret. Used to verify X-Hub-Signature-256.
META_APP_SECRET=
# Long-lived Page access token with leads_retrieval permission, to fetch each lead's answers.
META_PAGE_ACCESS_TOKEN=
# Graph API version to call (check Meta's current version).
META_GRAPH_API_VERSION=v23.0

