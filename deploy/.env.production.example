# Copy to deploy/.env.production on the server (chmod 600). Never commit it.
# Generate each secret with:  openssl rand -hex 32

# Public address (Traefik routes it here and gets the HTTPS certificate).
CRM_DOMAIN=crm.example.com

# Precon's own Postgres container. Hex only, so it is safe inside the URL.
POSTGRES_PASSWORD=

# API settings (see api/.env.example for what each one does).
JWT_SECRET=
JWT_EXPIRES_IN=8h
CORS_ORIGINS=https://crm.example.com
OPERATIONS_ENABLED=false
BUSINESS_TIMEZONE=Asia/Kolkata
PUBLIC_FILE_BASE_URL=https://crm.example.com
# COMPANY_NAME=Precon

# Meta (Facebook) Lead Ads webhook: leave empty until the Meta app is set up.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0
